features-adblocker-using-an-adblocker = اشتہار بلاکر استعمال کرݨ سوکھا ہے۔ بھروسے دے ٻئے آپشن براؤزر ایڈ آنز دے طور تے دستیاب ہن، جیندے نال تہاݙیاں ضرورتاں دے مطابق حل لبھݨ سوکھا ہے۔ مثال دے طور تے، <a href="{ $firefox }">{ -brand-name-firefox }</a> <a href="{ $addons }">منظور شدہ ایکسٹینشنز دی ہک فہرست</a> پیش کریندے جیندے تہاݙی پرائیویسی دا احترام کریندے ہوئے تہاݙا براؤزنگ تجربہ بہتر بݨاوݨ کیتے ڈیزائن کیتا ڳیا ہے۔
features-adblocker-finding-the-right = تہاݙے کیتے درست اشتہار بلاکر لبھݨ
features-adblocker-there-are-many = اشتہار بلاکنگ دے ٻئے اوزار ہن جیندے وچوں تیکوں تلاش کر سڳدے ہو، ہر ایک وچ مختلف ترجیحات دے مطابق فیچر ہن۔ تہاݙے کیتے درست آپشن دا انحصار تہاݙیاں خواہشاں تے براؤزنگ عادتاں تے ہے۔ غور کرݨ کیتے کجھ ٹپس ایہہ ہن:
features-adblocker-tip-1 = <strong>اشتہارات بلاک کرݨ:</strong> جے تساں صرف اشتہارات بلاک کرݨ چہندے ہو تاں ہک سادہ تے ہلکا آپشن چݨو۔
features-adblocker-tip-2 = <strong>پرائیویسی خدشات:</strong> جے تیکوں ٹریکرز دی فکر ہے تاں بلٹ ان پرائیویسی فیچرز آلا اشتہار بلاکر لبھو۔
features-adblocker-tip-3 = <strong>حسب ضرورت بݨاوݨ:</strong> کجھ اشتہار بلاکر مخصوص سائٹاں کوں وائٹ لسٹ کرݨ یا مخصوص عناصر بلاک کرݨ کیتے باریک ایڈجسٹمنٹ دی اجازت ݙیندن۔
features-adblocker-tip-4 = <strong>ڈیوائس مطابقت:</strong> غور کرو جو تیکوں ایندی ڈیسک ٹاپ، موبائل، یا ݙوہاں کیتے ضرورت ہے۔
features-adblocker-tip-5 = <strong>میلویئر بلاکنگ:</strong> کجھ اشتہار بلاکر نقصان دہ اشتہارات توں بچیندن (مثال دے طور تے، AdGuard)۔
features-adblocker-tip-6 = <strong>والدین کنٹرولز:</strong> جے تساں نامناسب مواد بلاک کرݨ چہندے ہو تاں کارآمد ہے۔
features-adblocker-its-important-to-note = ایہہ ڳالھ غور کرݨ لائق ہے جو کجھ ویب سائٹاں مواد لوڈ کرݨ یا فنکشنلٹی ݙیوݨ کیتے اشتہارات تے انحصار کریندین۔ اشتہارات بلاک کرݨ نال فیچر خراب تھی سڳدن، جیویں ویڈیو نہ چلݨ یا لاگ ان آپشن ناکام تھیوݨ۔ ایہہ اشتہار بلاکر چݨو جو باقاعدگی نال اپ ڈیٹ تھیندا ہے تے جے کوئی ہک اشتہار بلاکر وݙے مسائل پیدا کرے تاں ٻیا آزماوو تاں جو کارکردگی تے مطابقت دا بہتر توازن لبھ سڳو۔
features-adblocker-enhanced-privacy = { -brand-name-firefox } نال بہتر پرائیویسی تے کارکردگی
features-adblocker-beyond-ad-blockers = اشتہار بلاکرز توں ہٹ کے، { -brand-name-firefox } وچ بلٹ ان فیچر ہن جو تیکوں تہاݙی براؤزنگ تے ٻئی وݙا کنٹرول ݙیندن۔ ایہہ اوزار تہاݙی پرائیویسی دی حفاظت کریندن جݙاں تساں اپݨا تجربہ حسب ضرورت بݨیندے ہو:
features-adblocker-tool-1 = <strong>معیاری موڈ:</strong> ہک متوازن آپشن جو ویب سائٹ دے سہولت نال چلݨ کوں برقرار رکھیندے ہوئے عام ٹریکرز کوں بلاک کریندے۔
features-adblocker-tool-2 = <strong>سخت موڈ:</strong> اوں صارفاں کیتے بہترین جو زیادہ ٹریکرز تے کوکیز بلاک کر کے مضبوط پرائیویسی تحفظ چہندن۔ یاد رکھو جو کجھ سائٹاں کوں ایں موڈ وچ ایڈجسٹمنٹ دی ضرورت ہو سڳدی ہے۔
features-adblocker-tool-3 = <strong>حسب ضرورت موڈ:</strong> اوں لوکاں کیتے جو مکمل کنٹرول چہندن، حسب ضرورت موڈ تیکوں ایہہ چݨݨ ݙیندے جو کیا بلاک کرݨا ہے، کوکیز توں گھن کے ٹریکرز تائیں تے ٻیا وی۔
features-adblocker-to-adjust = ایہہ سیٹنگز ایڈجسٹ کرݨ کیتے، کہیں وی ویب پیج تے ایڈریس بار دے کھبے پاسے شیلڈ آئیکون تے کلک کرو تے پروٹیکشن سیٹنگز چݨو۔ ایندے نال ہک مینو کھلسے جتھے تساں اپݨے کیتے تحفظ دا درست لیول چݨ سڳدے ہو۔
features-adblocker-why-use = اشتہار بلاکر کیوں استعمال کرو؟
features-adblocker-ad-blockers-do-more = اشتہار بلاکر صرف اشتہارات سنبھالݨ توں ٻیا ٻہت کجھ کریندن — او غیر ضروری مواد گھٹا کے تہاݙی براؤزنگ دی رفتار تے سکیورٹی ودھا سڳدن۔ او تیکوں اپݨی پسند دا، بغیر خلل آلا ویب تجربہ بݨاوݨ دی طاقت ݙیندن، تاں جو تساں سب توں اہم چیزاں تے توجہ ݙے سڳو۔
