# HTML page description
features-translate-firefox-translations-is-a-built-in-v2 = { -brand-name-firefox-translations } ہک بلٹ ان ترجمانی فیچر ہے جو تیکوں اپݨی پسندیدہ زبان وچ ویب تے سوکھے براؤز کرݨ دی سہولت ݙیندے۔ ایں فیچر دے { -brand-name-firefox } وچ کم کرݨ دے طریقے دے بارے وچ ٻیا ڄاݨو، تے ایہہ وی جو { -brand-name-mozilla } تہاݙا ترجمہ پرائیویٹ رکھݨ وچ کیویں مدد کریندے۔
features-translate-one-of-the-best-things-about = انٹرنیٹ دے بارے وِچ ہِک چَن٘ڳی شے اِیہ ہِے جو اَساں ساری دُنیاں دے مواد تئیں رسائی حاصل کر سڳدے ہِسے۔ بھان٘ویں ایہ خبراں دے مضمون ہووِن، بلاگز ہووِن یا تُہاݙے نویں نروئے ٹیک گیجٹ دا جائزہ وی، تُساں اِیہ سارا کُجھ بظاہر کݙان٘ہیں نہ مُکّݨ آلی ویب اُتے لبّھ سڳدے ہِیوے۔ { -brand-name-firefox }دے ترجمے دی نویں نروئی خاصیت دے نال، اِیہ ٹول ہِک ویب ورقے دا حقیقی ویلے وِچ مسلسل ترجمہ کریسی۔
features-translate-while-other-browsers-rely-on-v2 = جݙاں ٻئے براؤزر کلاؤڈ سروسز تے انحصار کریندن، { -brand-name-firefox-translations } دے لینگویج ماڈل صارف دے براؤزر تے ڈاؤن لوڈ تھیندن تے ترجمے مقامی طور تے کیتے ویندن، تاں { -brand-name-mozilla } ایہہ ریکارڈ نیں کریندا جو تساں کیڑھے ویب پیج ترجمہ کریندے ہو۔
features-translate-when-you-translate-a-webpage = تساں جہڑے ویلے ویب ورقے دا ترجمہ کریسو، ایہ پرائیویٹ تھی ویندے
features-translate-when-your-translations-are = جہڑیلے تُہاݙے ترجمیاں اُتے مقامی طور تے کارروائی کِیتی وین٘دی ہِے، تاں تُہاݙی چُݨی ڳئی ڈیوائس دا کُئی ڈیٹا تُہاݙی ڈیوائس کوں نِھیں چُھڑین٘دا یا ترجمے کِیتے کلاؤڈ خدمتاں اُتے انحصار کائنی کرین٘دا۔ اِین٘دا مطلب اِیہ ہِے جو { -brand-name-mozilla } نِھیں ڄاݨدا جو تُساں کِہڑے ویب ورقے دا ترجمہ کرین٘دے ہِیوے، اَتے ترجمے دے ٻئے ٹولز دے مقابلے وِچ اَساݙی ترجمے دی خاصیت کوں وکھرا کرین٘دا ہِے۔
features-translate-what-languages-are-currently = حالیہ کہڑیاں زباناں دی سپورٹ ہے؟
# This is followed by a localized list of supported languages
features-translate-the-languages-below-are-what-v2 = ہیٹھ ݙتیاں ڳئیاں زباناں ہݨ { -brand-name-firefox-translations } فیچر ولوں سپورٹ کیتیاں ویندین:
features-translate-and-more-languages-are-in = ڈیویلپمنٹ وچ ٻیاں زباناں شامل کرو!
features-translate-firefox-speaks-your-language = { -brand-name-firefox } تہاݙی زبان الیندے
