# HTML page description
manifesto-these-are-the-principles = ایہ او اصول ہن جیڑھے ویب تے کھلے پن، اختراع تے مواقع کوں فروغ ݙیوݨ دے اساݙے مشن دی رہنمائی کریندے او۔
manifesto-the-internet-is-an-integral = انٹرنیٹ جدید زندگی دا ہک لازمی حصہ ہے — تعلیم، مواصلات، تعاون، کاروبار، تفریح تے مجموعی طور تے معاشرے وِچ ہک اہم جزو۔
manifesto-the-internet-is-a-global = انٹرنیٹ ہک عالمی عوامی وسیلہ ہے جہڑا کھلا تے پہنچ وچ رہوݨا چاہیدا ہے۔
manifesto-the-internet-must-enrich = انٹرنیٹ کوں انفرادی انسانی حیات کوں بہتر بݨاوݨاں  چاہیدا ہے۔
manifesto-individuals-security-and = انٹرنیٹ تے افراد دی سلامتی تے رازداری بݨیادی ہن، انہاں کوں اختیاری کائنی سمجھݨاں چاہیدا۔
manifesto-individuals-must-have = افراد کوں انٹرنیٹ  تے اوں تے آپݨے تجربے تشکیل کرݨ دی صلاحیت ہووݨی چاہیدی ہے۔
manifesto-the-effectiveness-of-the = عوامی وسائل دے طور تے انٹرنیٹ دی تاثیر دا انحصار انڈر آپریبلٹی (پروٹوکول، ڈیٹا فارمیٹس، مواد) جدت طرازی تے دنیا بھر وِچ مرکز گریز شرکت تے ہے۔
manifesto-free-and-open-source-software = مفت تے کھلا ماخذ سافٹ ویئڑ عوامی وسیلے دی حیثیت نال انٹرنیٹ دی ترقی کوں فروغ ݙیندن۔
manifesto-commercial-involvement = انٹرنیٹ دی ترقی وِچ تجارتی شمولیت ٻہوں سارے فائدے آنیندی ہے۔ تجارتی منفاع تے عوامی فائدے دے درمیان توازن ضروری ہے۔
manifesto-magnifying-the-public = انٹرنیٹ دے عوامی فائدے دے پُکھاں کوں ودھاوݨ ہک اہم مقصد ہے، جیڑھا، وقت، توجہ تے عزم دے لائق ہے۔
manifesto-pledge-for-a-healthy-internet = صحت مند انٹرنیٹ کیتے عہد
manifesto-the-open-global-internet = کھلا، عالمی نیٹ سبھ توں طاقتور مواصلات تے تعاون دا وسیلہ ہے جیڑھا اساں کݙاہیں ݙٹھا ہے۔ ایہ انسانی ترقی کیتے اساݙیاں کجھ امیداں کوں مجسم کریندا ہے۔ ایہ سیکھݨ، مشترکہ انسانیت دا احساس پیدا کرݨ، تے ہر جاہ لوکاں کوں درپیش اہم مسائل کوں حل کرݨ دے نویں مواقع فراہم کریندا ہے۔
manifesto-over-the-last-decade-we = پچھلے ݙہاکے وِچ اساں ایں وعدے کوں کئی طریقیاں نال پورا تھیندا ݙٹھا ہے۔ اساں انٹرنیٹ دی طاقت کوں وی ݙٹھا ہے جیندا استعمال تفرقہ انگیزی کوں ودھاوݨ، تشدد کوں ہوا ݙیوݨ، نفرت کوں فروغ ݙیوݨ، تے ڄاݨ ٻجھ تے حقیقت تے حقیقت وِچ ہیرا پھیری کیتے کیتا ویندا ہے۔ اساں سکھیا ہے جو اساکوں انٹرنیٹ دے انسانی تجربے کیتے اپݨیاں خواہشاں کوں زیاہ واضح طور تے بیان کرݨا چاہیدا ہے۔ اساں ہݨ ایویں کریندے ہیں۔
manifesto-we-are-committed-to-people = اساں ہک اینجھے انٹرنیٹ کیتے سرٻدھ ہیں جیندے وِچ دھرتی تے سبھے لوک شامل ہن —جتھاں کہیں ڄݨے دیاں آبادیاتی خصوصیتاں انہاں دی آن لائن رسائی، مواقع یا تجربے دے معیار دا تعین نہیں کریندیاں۔
manifesto-we-are-committed-to-discourse = اساں ہک اینجھے انٹرنیٹ کیتے سرٻدھ ہیں جیڑھی مہذب گفتگو، انسانی وقار تے انفرادی اظہار کوں فروغ ݙیندا ہے۔
manifesto-we-are-committed-to-thinking = اساں ہک اینجھے انٹرنیٹ کیتے سرٻدھ ہیں جیڑھا تنقیدی سوچ، معقول دلیل، مشترکہ علم، تے قابل تصدیق حقائق کوں بلند کریندا ہے۔
manifesto-we-are-committed-to-diverse = اساں ہک اینجھے انٹرنیٹ کیتے سرٻدھ ہیں جیڑھا سانجھی چنڳائی کیتے رل تے کم کرݨ والیاں ونو ون بیادریاں دے وچال تعاون کوں متحرک کریندا ہے۔
manifesto-an-internet-with-these = انہاں خصوصیات دے نال انٹرنیٹ خود ای زندہ نہ تھیسے۔ ڄݨے تے تنظیماں کوں انہاں خواہشاں کوں انٹرنیٹ ٹیکنالوجی تے انٹرنیٹ دے نال انسانی تجربے وِچ شامل کرݨا چاہیدا ہے۔ { -brand-name-mozilla } منشور تے ضمیمہ انہاں خواہشاں کوں اڳوں تے ودھاوݨ کیتے { -brand-name-mozilla } دے عزم دی نمائندگی کریندے ہن۔ اساݙا مقصد ہر جاہ انہاں لوکاں تے تنظیماں دے نال رل تے کم کرݨ ہے جیڑھے انٹرنیٹ کوں ہر ہک کیتے ٻیا وی بہتر جاہ بݨاوݨ کیتے انہاں مقاصد دا اشتراک کریندے ہن
