cookie-settings-page-title = کوکی ترتیباں
cookie-settings-page-desc = ایہ صفحہ کوکیز دے مختلف قسمّاں کوں بیان کریندے جیڑھیاں { -brand-name-mozilla } استعمال کر سگدی ہے، تے تیکوں ایہ اختیار ݙیندے کہ تساں کنہاں قسماں دے ڈیٹا تے راضی ہو جیڑھا { -brand-name-mozilla } اکٹھا کریندی ہے۔
cookie-settings-breadcrumb-link = پچھلا ورقہ
cookie-settings-explainer = کوکیز چھوٹیاں فائلاں ہن جنہاں وچ معلومات دے حصے ہوندن جیڑھے تہاݙے کمپیوٹر یا آلے تے محفوظ تھی ویندن جڈاں تساں کہیں ویب سائٹ تے ویندے ہو۔ { -brand-name-mozilla } کوکیز کوں ایندے کیتے استعمال کریندی ہے کہ ساݙیاں ویب سائٹاں چلن، تے ایندے کیتے وی کہ تساں ساݙیاں ویب سائٹاں نال کیویں ورتیندے ہو تے کیویں رابطہ رکھدے ہو، جیویں کہ او صفحے جیڑھے تساں ݙیکھدے ہو، ایندے بارے وچ معلومات اکٹھیاں کروں۔
cookie-settings-page-intro-v2 = ایہ صفحہ کوکیز تے اوہناں نال رلدیاں ٹیکنالوجیاں دے مختلف قسمّاں کوں بیان کریندے، جیویں کہ پکسل ٹیگز، ویب بیکنز، کلیئر GIFs، جاوا اسکرپٹ تے لوکل اسٹوریج (ہݨ توں، 'کوکیز') جیڑھیاں { -brand-name-mozilla } استعمال کر سگدی ہے، تے تیکوں ایہ اختیار ݙیندے کہ تساں کنہاں قسماں دے ڈیٹا تے راضی ہو جیڑھا { -brand-name-mozilla } اکٹھا کریندی ہے۔
cookie-settings-how-mozilla-heading = { -brand-name-mozilla } کین٘ویں کوکیاں ورتیندے
cookie-settings-how-does-mozilla-use-subheading = { -brand-name-mozilla } ایہ ڈیٹا کین٘ویں ورتیندے؟
cookie-settings-save-changes = تبدیلیاں محفوظ کرو
cookie-settings-your-cookie-settings-have = تہاݙیاں کوکی ترتیباں اپ ڈیٹ تھی ڳیاں۔
cookie-settings-i-agree = میں متفق ہاں
cookie-settings-i-do-not-agree = میں راضی کائنی
cookie-settings-turn-on-javascript = سوہݨا، آپݨیاں کوکی ترتیباں اپ ڈیٹ کرݨ کیتے جاوا سکرپٹ آن کرو۔

## Necessary cookies section

cookie-settings-category-necessary-heading = ضروری
cookie-settings-category-necessary-what-are-subheading = ضروری کوکیاں کیا ہن؟
cookie-settings-category-necessary-what-are-desc = ایہ ٹیکنالوجیاں ویب سائٹ دے ضروری فیچراں دی مدد کیتے لازم ہن، جیویں کہ کہیں ویب سائٹ دے محفوظ حصے وچ لاگ اِن کرݨ یا آن لائن خریداری دی ٹوکری وچ شئیں شامل کرݨ، تے اینہاں کوں بند نئیں کیتا ونڄ سگدا۔
cookie-settings-category-necessary-how-does-desc-v2 = { -brand-name-mozilla } ضروری کوکیز کوں صرف ویب سائٹ دے ضروری فیچر فراہم کرݨ کیتے استعمال کریندی ہے، جیویں کہ تہاݙے { -brand-name-mozilla-account } نال لاگ اِن کرݨ یا چیک آؤٹ تے سافٹ ویئر دی سبسکرپشن خریدݨ۔ اینہاں ٹیکنالوجیاں دے بغیر، ویب سائٹ دے ضروری فیچر کم نئیں کر سگدے۔

## Preference cookies section

cookie-settings-category-preference-heading = ترجیح
cookie-settings-category-preference-what-are-subheading = ترجیح کوکیاں کیا ہن؟
cookie-settings-category-preference-what-are-desc = ایہ ٹیکنالوجیاں تہاݙے انہاں انتخاباں کوں یاد رکھݨ کیتے استعمال تھیندیاں ہن جیڑھے تساں کہیں ویب سائٹ دے پچھلے دورے دوران کیتے ہن۔ مثالاں وچ ایہ شامل تھی سگدن کہ تساں کنہاں زبان وچ پڑھݨ پسند کریندے ہو، یا تہاݙی پسندیدہ رنگ تھیم کنہاں ہے۔
cookie-settings-category-preference-how-does-desc = { -brand-name-mozilla } ترجیحی کوکیز کوں تہاݙیاں ترجیحاں دی عزت کرݨ تے ساݙیاں ویب سائٹاں تے آوݨ ویلے تہاݙے تجربے کوں بہتر کرݨ کیتے استعمال کریندی ہے۔ اینہاں کوں تجزیاتی مقصداں کیتے استعمال نئیں کیتا ویندا۔ ترجیحی کوکیز ضروری کوکیز وانگوں فیچراں دی مدد کریندیاں ہن، پر کہیں ویب سائٹ اینہاں دے بغیر وی چل سگدی ہے۔ ایں کیتے، تساں اینہاں دے استعمال توں آپٹ آؤٹ کرݨ دا انتخاب کر سگدے ہو۔

## Analytics cookies section

cookie-settings-category-analytics-heading = تجزیاتی
cookie-settings-category-analytics-what-are-subheading = تجزیاتی کوکیاں کیا ہن؟
cookie-settings-category-analytics-what-are-desc = ایہ ٹیکنالوجیاں ایہ معلومات اکٹھیاں کریندیاں ہن کہ لوک ویب سائٹاں کوں کیویں استعمال کریندے ہن، جیویں کہ کہیں صفحات ݙیکھے ڳئے، کہیں لنکس تے کلک کیتا ڳیا، تے انہاں دا دورہ کہیں ٻیاں ویب سائٹاں توں شروع تھیا۔
cookie-settings-category-analytics-how-does-desc = { -brand-name-mozilla } تجزیاتی معلومات کوں ایں کیتے استعمال کریندی ہے تاں جو سمجھ سگے کہ صارفین ساݙیاں ویب سائٹاں نال کینویں تعامل کریندے ہن تاں جو اساں اینہاں کوں بہتر بݨا سگوں، تے پیدا تھیوݨ آلیاں کہیں وی مسلیاں کوں حل کر سگوں۔ اساں کوکیز دے ڈیٹا، ڈیوائس دی معلومات، تے IP ایڈریساں کوں وی استعمال کر سگدے ہاں تاں جو سمجھ سگوں کہ صارفین ساݙیاں مصنوعات، خدمتاں، مواصلات، ویب سائٹاں، آن لائن مہماں، ڈیوائساں، تے ٻئیاں پلیٹ فارماں نال کینویں جُڑدے ہن۔ اساں صرف تہاݙی رضامندی نال تجزیاتی معلومات اکٹھیاں کریسوں تے تجزیاتی کوکیز سیٹ کریسوں۔

## Privacy section

cookie-settings-privacy-heading = ساݙا رازداری نوٹس
cookie-settings-privacy-desc = جڈاں تساں ساݙیاں ویب سائٹاں تے ویندے ہو تاں { -brand-name-mozilla } کہڑے قسم دیاں معلومات اکٹھیاں کریندا ہے، انھاں دے بارے وچ ودھیک تفصیلی معلومات کیتے تساں تھلے ساݙے رازداری نوٹس دا لنک ڳھول سڳدے ہو۔
cookie-settings-privacy-policy-link = رازداری نوٹس
