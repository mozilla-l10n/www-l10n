### URL: https://www-dev.allizom.org/firefox/accounts/

# HTML page title
mozilla-accounts-get-a-mozilla-account = { -brand-name-mozilla-account } بسازید؛ داده‌هایتان را خصوصی، امن و همگام نگه دارید
# HTML page description
mozilla-accounts-securely-sync-your = گذرواژه‌ها، نشانک‌ها و زبانه‌هایتان را به‌شکلی امن در همهٔ دستگاه‌هایتان همگام کنید. همین حالا { -brand-name-mozilla-account } بسازید؛ یک ورود، با قدرت و حریم خصوصی در همه‌جا.
firefox-accounts-enter-your-email-address = برای آغاز، نشانی رایانامه خود را وارد کنید.
firefox-accounts-already-have-an-account = پیش از این حساب داشته‌اید؟
firefox-accounts-sign-in = ورود
mozilla-accounts-already = شما از قبل { -brand-name-mozilla-account } دارید. تبریک!
firefox-accounts-manage = حساب کاربری خود را مدیریت کنید
mozilla-account-header = { -brand-name-mozilla-account }
# This is followed by a list of things you can do with your Mozilla account
mozilla-account-sign-in-to = به { -brand-name-mozilla-account } خود وارد شوید تا:
# Variables:
#   $send (url) - link to https://blog.mozilla.org/en/products/firefox/firefox-tips/firefox-secret-tips/#send-tabs
firefox-accounts-send-a-tab = <a href="{ $send }">یک زبانه را به دستگاه دیگری ارسال کنید</a>
# Variables:
#   $password (url) - link to https://www.mozilla.org/firefox/features/password-manager/
firefox-accounts-save-and-sync = <a href="{ $password }">گذرواژه‌ها را ذخیره و همگام‌سازی کنید</a>
firefox-accounts-get-email-alerts = زمانی که اطلاعات شما در یک رخنه اطلاعاتی شناخته شده ظاهر می‌شود، هشدارهای رایانامه‌ای دریافت کنید
firefox-accounts-protect-your-identity = با پنهان‌سازی امن شماره تلفن و رایانامه، از هویت خود محافظت کنید
firefox-accounts-keep-your-passwords = گذرواژه‌های خود را امن و قابل حمل نگهداری کنید.
firefox-accounts-travel-the-internet = در هر دستگاهی که دارید، ایمن وبگردی کنید.
firefox-accounts-encrypt-your = فعالیت شبکه خود را رمزگذاری کرده و نشانی IP خود را پنهان نمایید
firefox-accounts-we-never = ما هرگز داده‌های شبکه شما را ثبت، ردیابی یا هم‌رسانی نمی‌کنیم
firefox-accounts-get-it-all-on-every = در هر دستگاهی به آنها دسترسی داشته باشید، بدون اینکه نگران تغییر سیستم عامل باشید.

## The strings below are visually hidden in the page and replaced by logo wordmark images. They are still important for a11y and SEO.

firefox-accounts-firefox-browser = { -brand-name-firefox-browser }
firefox-accounts-mozilla-monitor = { -brand-name-mozilla-monitor }
firefox-accounts-mozilla-vpn = { -brand-name-mozilla-vpn }
