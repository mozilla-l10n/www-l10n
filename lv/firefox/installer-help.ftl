### URL: https://www-dev.allizom.org/firefox/installer-help/


## Required

installer-help-page-title = Jūsu lejupielāde tika pārtraukta
installer-help-main-tagline = Tas dažreiz notiek. Pamēģināsim kaut ko citu.
installer-help-action-channel = Šai lejupielādei vajadzētu būt jums piemērotākai.
installer-help-action-choose = Izvēlieties lejupielādi zemāk.

##

installer-help-firefox-release-title = { -brand-name-firefox-browser }
# Variables:
#   $trackers (number) - number of trackers blocked by Firefox (currently in the thousands)
installer-help-firefox-release-desc-v2 = Iegūstiet jaunāko. Automātiskā privātuma aizsardzība ir pieejama. Lejupielādējiet { -brand-name-firefox }, lai bloķētu vairāk nekā { $trackers } izsekotājus.
installer-help-firefox-beta-title-v2 = { -brand-name-firefox } { -brand-name-beta }
installer-help-firefox-beta-desc = Testējiet drīzumā izlaižamās funkcijas visstabilākajā pirmsizlaides versijā.
installer-help-firefox-developer-title-v2 = { -brand-name-firefox } { -brand-name-developer-edition }
installer-help-firefox-developer-desc = Veidojiet, testējiet, mērogojiet un veiciet citas darbības ar vienīgo pārlūku, kas paredzēts tikai izstrādātājiem.
installer-help-firefox-nightly-title-v2 = { -brand-name-firefox } { -brand-name-nightly }
installer-help-firefox-nightly-desc = Ieskatieties mūsu nākamās paaudzes tīmekļa pārlūkā un palīdziet mums to padarīt par labāko pārlūku.
installer-help-need-help = Vai nepieciešama palīdzība instalēšanā?
# Variables:
#   $url (url) - link to https://support.mozilla.org/kb/install-firefox-windows
installer-help-need-help-desc = Ja jums joprojām ir nepieciešama palīdzība ar instalēšanu, <a href="{ $url }">izlasiet pamācību mūsu atbalsta sadaļā.</a>
