# HTML page title
mozilla-accounts-get-a-mozilla-account = Iegūsti { -brand-name-mozilla-account } – turi savus datus privātus, drošus un vienādotus
# HTML page description
mozilla-accounts-securely-sync-your = Droši vienādo savas paroles, grāmatzīmes un cilnes starp visām savām ierīcēm! Iegūsti { -brand-name-mozilla-account } tagad – viena pieteikšanās – ietekme un privātums visur!
firefox-accounts-enter-your-email-address = Jāievada sava e-pasta adrese, lai uzsāktu.
firefox-accounts-already-have-an-account = Jau ir konts?
firefox-accounts-sign-in = Pieteikties
mozilla-accounts-already = Tev jau ir { -brand-name-mozilla-account }. Apsveicam!
firefox-accounts-manage = Pārvaldīt savu kontu
mozilla-account-header = { -brand-name-mozilla-account }
# This is followed by a list of things you can do with your Mozilla account
mozilla-account-sign-in-to = Piesakies savā { -brand-name-mozilla-account }, lai:
# Variables:
#   $send (url) - link to https://blog.mozilla.org/en/products/firefox/firefox-tips/firefox-secret-tips/#send-tabs
firefox-accounts-send-a-tab = <a href="{ $send }">Nosūtīt cilni</a> uz citu ierīci
# Variables:
#   $password (url) - link to https://www.mozilla.org/firefox/features/password-manager/
firefox-accounts-save-and-sync = <a href="{ $password }">Saglabāt un vienādot paroles</a>

